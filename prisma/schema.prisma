generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String     @id @default(cuid())
  name                   String
  email                  String     @unique
  password               String
  plan                   String     @default("PRO")
  status                 String     @default("ACTIVE")
  ownerName              String     @default("")
  phone                  String     @default("")
  city                   String     @default("")
  onboardingCompleted    Boolean    @default(true)
  works                  MenuWork[]
  ingredientRates        TenantIngredientRate[]
  createdAt              DateTime   @default(now())
  razorpayCustomerId     String?
  razorpaySubscriptionId String?    @unique
  subscriptionStatus     String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean    @default(false)
}

model MenuWork {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workData  Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model DishMasterItem {
  id              String   @id @default(cuid())
  name            String
  category        String
  subcategory     String   @default("")
  rate            Float
  servingQuantity Float    @default(1)
  servingUnit     String   @default("serving")
  aliases         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PendingDishSuggestion {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  categoryHint   String   @default("Other")
  tenantId       String
  sourceFileName String   @default("")
  occurrences    Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model DishCategoryCatalog {
  id            String   @id
  categories    Json
  subcategories Json     @default("{}")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model RecipeCatalog {
  id                   String   @id
  dishes               Json
  rates                Json
  ingredientCategories Json     @default("[]")
  deletedDishIds       Json
  catalogVersion       Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RazorpayWebhookEvent {
  id        String   @id
  eventType String
  createdAt DateTime @default(now())
}


model TenantIngredientRate {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ingredientId String
  rate         Float

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, ingredientId])
  @@index([tenantId])
}
