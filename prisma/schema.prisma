generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String     @id @default(cuid())
  name                   String
  email                  String     @unique
  password               String
  plan                   String     @default("PRO")
  status                 String     @default("ACTIVE")
  ownerName              String     @default("")
  phone                  String     @default("")
  city                   String     @default("")
  onboardingCompleted    Boolean    @default(true)
  works                  MenuWork[]
  ingredientRates        TenantIngredientRate[]
  autoRecipes            TenantAutoRecipe[]
  freeCostings            TenantFreeCosting[]
  costingHistory          TenantCostingHistory[]
  quotations              TenantQuotation[]
  draftCostings            TenantDraftCosting[]
  createdAt              DateTime   @default(now())
  razorpayCustomerId     String?
  razorpaySubscriptionId String?    @unique
  subscriptionStatus     String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean    @default(false)
}

model TenantAutoRecipe {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  normalizedName String
  name           String
  category       String   @default("Other")
  baseGuests     Int      @default(100)
  ingredients    Json
  costPerPlate   Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, normalizedName])
  @@index([tenantId, updatedAt])
}

model MenuWork {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workData  Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model DishMasterItem {
  id              String   @id @default(cuid())
  name            String
  category        String
  subcategory     String   @default("")
  rate            Float
  servingQuantity Float    @default(1)
  servingUnit     String   @default("serving")
  aliases         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PendingDishSuggestion {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  categoryHint   String   @default("Other")
  tenantId       String
  sourceFileName String   @default("")
  occurrences    Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model DishCategoryCatalog {
  id            String   @id
  categories    Json
  subcategories Json     @default("{}")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model RecipeCatalog {
  id                   String   @id
  dishes               Json
  rates                Json
  ingredientCategories Json     @default("[]")
  deletedDishIds       Json
  catalogVersion       Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RazorpayWebhookEvent {
  id        String   @id
  eventType String
  createdAt DateTime @default(now())
}


model ProductAnalyticsEvent {
  id        String   @id @default(cuid())
  eventName String
  tenantId  String?
  visitorId String
  path      String   @default("")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([tenantId, createdAt])
  @@index([visitorId, createdAt])
}



model TenantFreeCosting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costingId String
  createdAt DateTime @default(now())

  @@unique([tenantId, costingId])
  @@index([tenantId, createdAt])
}

model TenantCostingHistory {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costingId            String
  eventName            String   @default("")
  clientName           String   @default("")
  eventDate            String   @default("")
  menuCount            Int      @default(0)
  totalCovers          Int      @default(0)
  totalCost            Float    @default(0)
  sellingPricePerPlate Float    @default(0)
  totalSelling         Float    @default(0)
  totalProfit          Float    @default(0)
  snapshot             Json
  completedAt          DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  archivedAt           DateTime?

  @@unique([tenantId, costingId])
  @@index([tenantId, completedAt])
}


model TenantDraftCosting {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costingId            String
  eventName            String   @default("")
  clientName           String   @default("")
  eventDate            String   @default("")
  menuCount            Int      @default(0)
  totalCovers          Int      @default(0)
  totalCost            Float    @default(0)
  sellingPricePerPlate Float    @default(0)
  totalSelling         Float    @default(0)
  totalProfit          Float    @default(0)
  workData             Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, costingId])
  @@index([tenantId, updatedAt])
}


model TenantQuotation {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costingId            String
  quotationNumber      String   @unique
  status               String   @default("DRAFT")
  clientName           String   @default("")
  clientPhone          String   @default("")
  eventName            String   @default("")
  eventDate            String   @default("")
  venue                String   @default("")
  city                 String   @default("")
  totalCovers          Int      @default(0)
  pricePerCover        Float    @default(0)
  includeTotal         Boolean  @default(true)
  subtotal             Float    @default(0)
  gstPercent           Float    @default(0)
  gstAmount            Float    @default(0)
  extraLabel           String   @default("")
  extraAmount          Float    @default(0)
  grandTotal           Float    @default(0)
  validityDays         Int      @default(7)
  advancePercent       Float    @default(50)
  paymentTerms         String   @default("")
  terms                Json     @default("[]")
  notes                String   @default("")
  publicSnapshot       Json     @default("{}")
  sentAt               DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, costingId])
  @@index([tenantId, status, updatedAt])
}

model TenantIngredientRate {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ingredientId String
  rate         Float

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, ingredientId])
  @@index([tenantId])
}
